{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pytest*)",
      "Bash(python3 -m venv *)",
      "Bash(pip install *)",
      "Bash(ffmpeg -version)",
      "Bash(ffmpeg -hide_banner *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",

      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",

      "WebFetch(domain:www.subsonic.org)",
      "WebFetch(domain:www.navidrome.org)",
      "WebFetch(domain:ffmpeg.org)"
    ]
  }
}
