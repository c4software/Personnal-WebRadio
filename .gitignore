# Secrets (SPECS.md §6.1). .env.exemple, lui, est versionné : il ne porte
# que des noms de variables.
.env
.env.*
!.env.exemple

# Configuration locale (SPECS.md §6)
webradio.toml
*.local.toml

# Réglages machine du harnais
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Outillage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Fichiers audio : le dossier jingles/ est versionné vide, son contenu jamais
jingles/*
!jingles/.gitkeep
!jingles/hours/
jingles/hours/*
!jingles/hours/.gitkeep
*.mp3
*.aac
*.ogg
*.flac
*.wav

# Divers
.DS_Store
